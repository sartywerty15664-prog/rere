{
  "name": "mindlarp-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MindLarp model family website, documentation, and API console",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H ${HOST:-0.0.0.0} -p ${PORT:-5173}",
    "build": "next build",
    "start": "next start -H ${HOST:-0.0.0.0} -p ${PORT:-3000}",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:import": "node --env-file-if-exists=.env scripts/import-json.js",
    "check:production": "node --env-file-if-exists=.env scripts/check-production.js",
    "test": "npm run build && node --test",
    "check": "shopt -s globstar nullglob && for file in proxy.js next.config.mjs src/**/*.js app/**/*.js components/**/*.js public/*.js scripts/**/*.js test/**/*.js; do node --check \"$file\" || exit 1; done"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "next": "^16.4.6",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.1.0"
  }
}
